# Copy to .env and adjust. Never commit .env.

# --- Database ---
DB_ROOT_PASSWORD=change-me-root
# Must stay "jobpipe": docker/mariadb/init/01_databases.sql grants permissions to this user
DB_USER=jobpipe
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306
RAW_DB=raw_portals
ANALYSIS_DB=analysis

# --- LLM access (stage 2 onwards) ---
OPENROUTER_API_KEY=

# --- Translation ---
# Model: phi-4 | qwen-2.5-7b | mistral-7b | gpt-oss-120b | or any full OpenRouter model id
TRANSLATE_MODEL=phi-4
# Parallel LLM calls
TRANSLATE_WORKERS=4
# Chunking for models with small context windows
CHUNK_MAX_WORDS=300
CHUNK_MAX_CHARS=2000
UNICODE_FORM=NFKD

# --- Tracing ---
# none: no tracing | opik: send every LLM call to Opik
TRACING=opik
OPIK_PROJECT_NAME=jobpipe
# Opik Cloud (free account at https://www.comet.com/opik):
OPIK_API_KEY=
OPIK_WORKSPACE=
# Or self-hosted Opik instead of the cloud (leave OPIK_API_KEY empty):
OPIK_URL_OVERRIDE=http://localhost:5173/api
